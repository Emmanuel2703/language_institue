DROP TABLE IF EXISTS Dim_Date;
Create Table Dim_Date (
    Datekey Int Primary Key,
    [Date] Date Null,
    [Year] Int Null,
    [Quarter] Int Null,
    [Quartername] Varchar(2) Null,
    [Month] Int Not Null,
    [Monthname] Varchar(15) Null,
    [Day] Int Not Null,
    [Dayofweeknumber] Int Null,
    [Dayofweekname] Varchar(15) Null
);
GO
With Alldates AS (
    -- تجميع كافة التواريخ الصالحة من جميع الحقول--
    Select Try_Cast(start_date As Date) As Cleandate From batch Where start_date Is Null
    Union All
    Select Try_Cast(end_date As Date) From batch Where end_date Is Null
    Union All
    Select Try_Cast(enrollment_date As Date) From batch_student Where enrollment_date Is Null
     Union All
    Select Try_Cast(exam_date As Date) From exames Where exam_date Is Null
     Union All
    Select Try_Cast(payment_date As Date) From payments Where payment_date Is Null
     Union All
    Select Try_Cast(session_date As Date) From session Where session_date Is Null
     Union All
    Select Try_Cast(date_of_birth As Date) From student Where date_of_birth Is Null
     Union All
    Select Try_Cast(hire_date As Date) From teacher Where hire_date Is Null
),
Daterange As (
    -- تحديد أقصى وأدنى تاريخ عبر جميع العمليات --
    Select 
        Min(Cleandate) As Startdate,
        Max(Cleandate) As Enddate
    From Alldates
    Where Cleandate Is Not Null 
      And Year(Cleandate) Between 1900 And 2099
),
Datesequence AS (
    Select Startdate As [Date], Enddate
    From Daterange
    
    UNION ALL
    
    Select Dateadd(Day, 1, [Date]), Enddate
    From Datesequence
    Where [Date] < Enddate
)
Insert Into Dim_Date
Select 
    (YEAR([Date]) * 10000) + (MONTH([Date]) * 100) + DAY([Date]) AS Datekey,
    [Date],
    YEAR([Date]) AS [Year],
    Datepart(Quarter, [Date]) As [Quarter],
    'Q' + Cast(Datepart(Quarter, [Date]) As Varchar(1)) As [Quartername],
    Month([Date]) As [Month],
    Datename(Month, [Date]) As [Monthname],
    Day([Date]) As [Day],
    Datepart(Weekday, [Date]) As [Dayofweeknumber],
    Datename(Weekday, [Date]) As [Dayofweekname]
From Datesequence
Option (Maxrecursion 0);

create or alter view dim_student as 
select 
s.student_id, 
s.student_name, 
s.gender,
s.date_of_birth, 
s.email,
s.mobile, 
s.registration_Date,
s.is_active,
a.AttendanceStatus,
b.batch_name,
l.level_name,
br.branch_name,
t.teacher_name
from student s 
inner join attendance a on a.student_id = s.student_id
inner join batch_student bs on bs.student_id = s.student_id
inner join batch b on bs.batch_id = b.batch_id
inner join exam_result er on er.student_id = s.student_id
inner join exames e on er.exam_id = e.exam_id
inner join level l on e.level_id = l.level_id
inner join branch br on b.branch_id = br.branch_id
inner join teacher t on b.teacher_id = t.teacher_id
----------------------------------------------------------------
create view dim_teacher as 
select 
t.teacher_id,
t.teacher_name,
t.email,
t.mobile,
t.hire_date,
t.is_active,
s.student_name,
br.branch_name,
b.batch_name
from teacher t
inner join session se on se.teacher_id = t.teacher_id
inner join attendance a on a.session_id = se.session_id
inner join student s on a.student_id = s.student_id
inner join batch b on b.teacher_id = t.teacher_id
inner join branch br on b.branch_id = br.branch_id

create table fact_table(
student_sk int null,
teacher_sk int null,
batch_sk int null,
exam_sk int null,
listening_score int null,
reading_score int null,
grammar_score int null,
speaking_score int null,
writing_score int null,
amount int null,
score int null,
max_score int null,
date_key int null,
);
INSERT INTO fact_table(
    student_sk,
    teacher_sk,
    batch_sk,
    exam_sk,
    listening_score,
    reading_score,
    grammar_score,
    speaking_score,
    writing_score,
    amount,
    score,
    max_score,
    date_key
)
SELECT
    ds.student_sk,
    dt.teacher_sk,
    db.batch_sk,
    de.exam_sk,
    pt.listening_score,
    pt.reading_score,
    pt.grammar_score,
    pt.speaking_score,
    pt.writing_score,
    ISNULL(p.amount, 0),
    ISNULL(er.score, 0),
    ISNULL(e.max_score, 0),
    dd.Datekey
FROM palcementtest pt
LEFT JOIN dim_student_table ds ON pt.student_id = ds.student_id
LEFT JOIN batch_student bs ON pt.student_id = bs.student_id
LEFT JOIN batch b ON bs.batch_id = b.batch_id
LEFT JOIN teacher t ON b.teacher_id = t.teacher_id
LEFT JOIN dim_teacher_table dt ON t.teacher_id = dt.teacher_id
LEFT JOIN dim_batch_table db ON b.batch_id = db.batch_id
LEFT JOIN exam_result er ON pt.student_id = er.student_id
    AND er.exam_id = (SELECT MIN(exam_id) FROM exam_result WHERE student_id = pt.student_id)
LEFT JOIN exames e ON er.exam_id = e.exam_id
LEFT JOIN dim_exam_table de ON e.exam_id = de.exam_id
LEFT JOIN Dim_Date dd ON CAST(pt.test_date AS DATE) = dd.[Date]
LEFT JOIN payments p ON pt.student_id = p.student_id;


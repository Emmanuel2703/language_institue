-----------------------------------------------------------------------
               ---Payments by Branch and Level.---
SELECT 
    br.branch_name,          -- اسم الفرع
    l.level_name,            -- اسم المستوى
    SUM(p.amount) AS total_payments, -- إجمالي المدفوعات
    COUNT(p.payment_id) AS total_transactions -- عدد عمليات الدفع
FROM payments p
-- ربط المدفوعات بالطالب
JOIN student s ON p.student_id = s.student_id
-- ربط المدفوعات بالـ Batch لمعرفة الفرع والمستوى المرتبطين
JOIN batch b ON p.batch_id = b.batch_id
-- ربط الفرع
JOIN branch br ON b.branch_id = br.branch_id
-- ربط المستوى
JOIN level l ON b.level_id = l.level_id
GROUP BY 
    br.branch_name,
    l.level_name
ORDER BY 
    br.branch_name,
    l.level_name;
----------------------------------------------------------------------
                      ----Attendance % by Batch.---
SELECT 
    b.batch_id,
    b.batch_code,
    b.batch_name,
    COUNT(a.AttendanceID) AS total_records, -- إجمالي سجلات الحضور والغياب
    SUM(CASE WHEN a.AttendanceStatus = 'Present' THEN 1 ELSE 0 END) AS present_count, -- عدد مرات الحضور الفعلي
    -- حساب نسبة الحضور المئوية
    CAST(
        (SUM(CASE WHEN a.AttendanceStatus = 'Present' THEN 1 ELSE 0 END) * 100.0) / 
        NULLIF(COUNT(a.AttendanceID), 0) 
        AS DECIMAL(5,2)
    ) AS attendance_percentage
FROM batch b
LEFT JOIN session s ON b.batch_id = s.batch_id
LEFT JOIN attendance a ON s.session_id = a.session_id
GROUP BY 
    b.batch_id,
    b.batch_code,
    b.batch_name
ORDER BY 
    attendance_percentage DESC;
-----------------------------------------------------------------------------
                    ---Average Exam Score and Pass Rate.---
SELECT 
    e.exam_id,
    e.exam_name,
    e.exam_type,
    e.max_score,
    COUNT(er.exam_result_id) AS total_students_tested, -- إجمالي عدد الطلاب الذين أُجريت لهم الاختبارات
    AVG(CAST(er.score AS DECIMAL(5,2))) AS average_score, -- متوسط الدرجات
    -- حساب نسبة النجاح المئوية بناءً على حالة النتيجة (مثلاً إذا كانت النتيجة 'Pass')
    CAST(
        (SUM(CASE WHEN er.result_status = 'Pass' THEN 1 ELSE 0 END) * 100.0) / 
        NULLIF(COUNT(er.exam_result_id), 0) 
        AS DECIMAL(5,2)
    ) AS pass_rate_percentage
FROM exames e
LEFT JOIN exam_result er ON e.exam_id = er.exam_id
GROUP BY 
    e.exam_id,
    e.exam_name,
    e.exam_type,
    e.max_score
ORDER BY 
    average_score DESC;
---------------------------------------------------------------------------------------
                  ---Placement Test analysis by Recommended Level.---
SELECT 
    l.level_id,
    l.level_code,
    l.level_name,
    l.cefr_level,
    COUNT(pt.placementtest_id) AS total_students_recommended, -- إجمالي عدد الطلاب الموصى بهم لهذا المستوى
    AVG(CAST(pt.listening_score AS DECIMAL(5,2))) AS avg_listening_score, -- متوسط درجات الاستماع
    AVG(CAST(pt.reading_score AS DECIMAL(5,2))) AS avg_reading_score,     -- متوسط درجات القراءة
    AVG(CAST(pt.grammar_score AS DECIMAL(5,2))) AS avg_grammar_score,     -- متوسط درجات القواعد
    AVG(CAST(pt.speaking_score AS DECIMAL(5,2))) AS avg_speaking_score,   -- متوسط درجات التحدث
    AVG(CAST(pt.writing_score AS DECIMAL(5,2))) AS avg_writing_score      -- متوسط درجات الكتابة
FROM level l
LEFT JOIN palcementtest pt ON l.level_id = pt.recommended_level_id
GROUP BY 
    l.level_id,
    l.level_code,
    l.level_name,
    l.cefr_level
ORDER BY 
    total_students_recommended DESC;
